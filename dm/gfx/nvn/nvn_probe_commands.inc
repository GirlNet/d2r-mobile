// 诊断专用参数捕获：来自已登记的 NVN 原型；不写可执行 GPU 命令，只允许提交前模式。
// Diagnostic argument capture from registered NVN prototypes; creates no executable GPU commands and is allowed only in pre-submit mode.

#define NVN_CAPTURE(name, ret, ...) NVN(name, ret, __VA_ARGS__)
static void probe_capture_call(const char *name, unsigned count, const unsigned long long *bits) {
    if (dm_boot_probe_capture_command(name,count,bits)) return;
    dm_boot_probe_block("unimplemented_nvn",name);
    die("Diagnostic-only NVN capture attempted outside pre-submit mode: %s",name);
}
